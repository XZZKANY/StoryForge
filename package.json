{
  "name": "storyforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "verify": "pnpm run verify:local",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:fast": "pnpm run lint",
    "hooks:install": "git config core.hooksPath .githooks",
    "dev": "pnpm desktop:dev",
    "desktop:dev": "pnpm --filter @storyforge/desktop dev",
    "desktop:build": "pnpm --filter @storyforge/desktop build",
    "test": "pnpm run test:desktop && pnpm run test:project-core && pnpm run test:engine",
    "test:fast": "node scripts/fast-tests.mjs",
    "test:desktop": "npm --prefix apps/desktop run verify",
    "test:project-core": "pnpm --filter @storyforge/project-core test",
    "test:engine": "pnpm --filter @storyforge/engine run typecheck && pnpm --filter @storyforge/engine test",
    "lint": "eslint . && prettier --check \"apps/desktop/frontend/src/**/*.{ts,tsx}\" \"packages/engine/src/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint:fix": "eslint . --fix && prettier --write \"apps/desktop/frontend/src/**/*.{ts,tsx}\" \"packages/engine/src/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0"
  }
}
